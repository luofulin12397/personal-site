---
import { site } from "../site";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about";
}

const { title, description = site.description, active } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 个人技术笔记`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <header class="masthead frame">
      <a class="signature" href="/" aria-label={`${site.name}，返回首页`}>
        <span class="seal" aria-hidden="true">罗</span>
        <span>{site.name}</span>
      </a>
      <nav aria-label="主导航">
        <a href="/" aria-current={active === "home" ? "page" : undefined}>首页</a>
        <a href="/about/" aria-current={active === "about" ? "page" : undefined}>关于</a>
      </nav>
    </header>

    <main id="main" class="frame" tabindex="-1">
      <slot />
    </main>

    <footer class="colophon frame">
      <span>{site.name}</span>
      <a href="/" class="text-link">回到首页 <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
