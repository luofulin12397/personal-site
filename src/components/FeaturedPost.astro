---
import type { Post } from "../publishing";
import { postHref } from "../site";

interface Props {
  post: Post;
  reason: string;
  diagram?: {
    label: string;
    steps: { title: string; detail: string; highlight?: boolean }[];
  };
}

const { post, reason, diagram } = Astro.props;
const href = postHref(post.data.slug);
const readLabel = post.data.kind === "interpretation" ? "读这篇解读" : post.data.note ? "读这篇笔记" : "阅读文章";
---
<section class="feature" aria-labelledby="featured-title">
  <p class="recommendation">我推荐先读</p>
  <h2 id="featured-title"><a href={href}>{post.data.title}</a></h2>
  <p class="feature-copy">{reason}</p>
  {diagram && (
    <figure class="feature-flow" aria-label={diagram.label}>
      <ol role="list">
        {diagram.steps.map((step) => (
          <li class:list={{ "flow-highlight": step.highlight }}>
            <strong>{step.title}</strong><span>{step.detail}</span>
          </li>
        ))}
      </ol>
    </figure>
  )}
  <a class="text-link" href={href}>
    {readLabel}
    <span aria-hidden="true">→</span>
  </a>
</section>
